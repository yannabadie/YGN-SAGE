# Force LF line endings for files that CI checks
.gitattributes text eol=lf
*.rs text eol=lf
*.toml text eol=lf
Cargo.lock text eol=lf
*.sh text eol=lf
*.jsonl text eol=lf
docs/superpowers/evidence/**/*.json text eol=lf
docs/superpowers/evidence/**/*.log text eol=lf
docs/superpowers/evidence/**/*.txt text eol=lf
