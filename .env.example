# YGN-SAGE env vars — copy to .env and fill in your own keys.
# Never commit .env (it's in .gitignore).

# --------------------------------------------------------------------
# LLM provider API keys (all optional — set what you use)
# --------------------------------------------------------------------
# At least ONE must be set for the system to boot. ProviderPool health-
# check probes each and disables unreachable / quota-dead providers.

GOOGLE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
MINIMAX_API_KEY=
KIMI_API_KEY=
OPEN_ROUTER_API_KEY=

# --------------------------------------------------------------------
# ExoCortex (File Search / RAG) — OPTIONAL
# --------------------------------------------------------------------
# As of 2026-04-18 (P1.3 multi-tenant fix, commit e338b7e), the
# ExoCortex store name is NO LONGER auto-defaulted. Previously it fell
# back to a project-maintainer store, which leaked tenancy into any
# `pip install ygn-sage` user. Now: explicit opt-in.
#
# If unset: ExoCortex features no-op silently (with a one-shot warning).
#   Agent tool `search_exocortex` returns empty. SWE-bench / code-
#   repair tasks don't depend on ExoCortex — they use execute_bash +
#   read_file against the target repo. So absence is fine for code
#   workflows. ExoCortex adds value for research / general-knowledge
#   grounding.
#
# If you're the project maintainer: set to your dev store.
SAGE_EXOCORTEX_STORE=

# Optional override for the Gemini model used by ExoCortex queries.
# Default: gemini-2.5-flash.
# SAGE_EXOCORTEX_MODEL=gemini-2.5-flash

# --------------------------------------------------------------------
# Miscellaneous
# --------------------------------------------------------------------
# SSL verify: leave unset (defaults to True). NEVER set false — this
# machine has NO corporate proxy. See .claude/rules/critical-directives.md §3.
# SAGE_SSL_VERIFY=true

# Path 6 learned topology policy (opt-in; off by default).
# SAGE_ENABLE_PATH6=1

# Planner-output injection into subsequent nodes (experimental, Apr 17).
# SAGE_PLANNER_INJECTION=1

# Live-provider pytest gate — opt-in, tests cost real money.
# SAGE_LIVE_PROVIDERS=1

# HuggingFace offline mode (useful on Windows when MBX firewall blocks
# hub calls — the cache under ~/.cache/huggingface still works).
# HF_HUB_OFFLINE=1
# HF_DATASETS_OFFLINE=1
